# Application Settings
PROJECT_NAME="Saark Operating System API"
API_V1_STR="/api/v1"
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION_JWT"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (AWS RDS PostgreSQL or Local PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saark_db"

# AWS Configuration (RDS, EC2, S3, CloudWatch)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_S3_BUCKET_NAME="saark-product-selector-documents"

# AWS CloudWatch Settings
ENABLE_CLOUDWATCH_LOGS="False"
CLOUDWATCH_LOG_GROUP="saark-api-logs"

# CORS Configuration (Commas separated origins)
CORS_ORIGINS="http://localhost,http://localhost:3000,http://localhost:8080,*"
