# Production Environment Configuration for AWS Deployment
PROJECT_NAME="Saark Operating System API"
API_V1_STR="/api/v1"
SECRET_KEY="REPLACE_WITH_A_STRONG_64_CHAR_SECRET_KEY_GENERATED_VIA_OPENSSL"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS RDS PostgreSQL Connection URL
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>
DATABASE_URL="postgresql://saark_admin:STRONG_PASSWORD_HERE@saark-postgres.c123456789.us-east-1.rds.amazonaws.com:5432/saark_production_db"

# AWS S3 Storage for Documents, Invoices, and Drawings
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_IAM_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_IAM_SECRET_ACCESS_KEY"
AWS_S3_BUCKET_NAME="saark-product-selector-documents"

# CORS Origins
CORS_ORIGINS="*"
